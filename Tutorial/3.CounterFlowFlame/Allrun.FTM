#!/bin/sh
cd "${0%/*}" || exit 1

. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

application=$(getApplication)

properties="constant/physicalProperties"
originalProperties="constant/physicalProperties.ori"

# Check the original DTM configuration
if [ ! -f "$originalProperties" ]
then
    echo "Error: $originalProperties does not exist."
    exit 1
fi

# Generate reactions and thermo.DTM
runApplication DTMchemkinToFoam \
    chemkin/chem.inp \
    chemkin/therm.dat \
    chemkin/tran.dat \
    chemkin/transportSutherland \
    constant/reactions \
    constant/thermo.DTM

runApplication blockMesh

# Copy the original DTM configuration
cp "$originalProperties" "$properties"

# Modify the copy for FTM preprocessing
sed -i \
    -e '/^[[:space:]]*usingPreProcessingFTM[[:space:]]/s/false/true/' \
    -e '/^[[:space:]]*transport[[:space:]]/s/DTMTransport/preprocessingFTMTransport/' \
    "$properties"

# Generate thermo.FTM
runApplication FTMchemkinToFoam

if [ ! -f constant/thermo.FTM ]
then
    echo "Error: constant/thermo.FTM was not generated."
    exit 1
fi

# Modify the copy for the final FTM simulation
sed -i \
    -e '/^[[:space:]]*usingCoTHERM[[:space:]]/s/false/true/' \
    -e '/^[[:space:]]*usingPreProcessingFTM[[:space:]]/s/true/false/' \
    -e '/^[[:space:]]*mixture[[:space:]]/s/DTMMulticomponentMixture/FTMMulticomponentMixture/' \
    -e '/^[[:space:]]*transport[[:space:]]/s/preprocessingFTMTransport/FTMTransport/' \
    -e '/^[[:space:]]*#include[[:space:]]/s/thermo.DTM/thermo.FTM/' \
    "$properties"

# Run the simulation
runApplication decomposePar
mpirun -np 4 "$application" -parallel
runApplication reconstructPar

#------------------------------------------------------------------------------
