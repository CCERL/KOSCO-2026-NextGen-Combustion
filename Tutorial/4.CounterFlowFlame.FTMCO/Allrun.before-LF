#!/bin/sh
cd "${0%/*}" || exit 1
. "${WM_PROJECT_DIR:?Load the OpenFOAM environment first}/bin/tools/RunFunctions" || exit 1
properties="constant/physicalProperties"
preprocessProperties="constant/physicalProperties.PP"
if [ ! -f "$preprocessProperties" ]
then
    echo "Error: $preprocessProperties does not exist." >&2
    exit 1
fi
application=$(getApplication) || exit 1
[ -n "$application" ] || exit 1
# Restore the supplied baseline if preparation fails or is interrupted.
restoreProperties()
{
    status=$?
    trap - 0 HUP INT TERM
    if ! cp "$preprocessProperties" "$properties"
    then
        echo "Error: could not restore $properties." >&2
        status=1
    fi
    exit "$status"
}
trap restoreProperties 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
cp "$preprocessProperties" "$properties" || exit 1
runApplication -o DTMchemkinToFoam \
    chemkin/chem.inp \
    chemkin/therm.dat \
    chemkin/tran.dat \
    chemkin/transportSutherland \
    constant/reactions \
    constant/thermo.DTM || exit 1
runApplication -o blockMesh || exit 1
# Activate FTM preprocessing (the supplied .PP already has these values).
sed -i \
    -e '/^[[:space:]]*usingPreProcessingFTM[[:space:]]/s/false/true/' \
    -e '/^[[:space:]]*transport[[:space:]]/s/DTMTransport/preprocessingFTMTransport/' \
    "$properties" || exit 1
rm -f constant/thermo.FTM || exit 1
runApplication -o FTMchemkinToFoam || exit 1
if [ ! -f constant/thermo.FTM ]
then
    echo "Error: constant/thermo.FTM was not generated." >&2
    exit 1
fi
# Discard temporary preprocessing edits before configuring the simulation.
cp "$preprocessProperties" "$properties" || exit 1
sed -i \
    -e '/^[[:space:]]*usingCoTHERM[[:space:]]/s/false/true/' \
    -e '/^[[:space:]]*usingPreProcessingFTM[[:space:]]/s/true/false/' \
    -e '/^[[:space:]]*mixture[[:space:]]/s/DTMMulticomponentMixture/FTMMulticomponentMixture/' \
    -e '/^[[:space:]]*transport[[:space:]]/s/preprocessingFTMTransport/FTMTransport/' \
    -e '/^[[:space:]]*#include[[:space:]]/s/thermo.DTM/thermo.FTM/' \
    "$properties" || exit 1
# Keep the FTMCO configuration for the simulation and its results.
trap - 0 HUP INT TERM
echo "Generated constant/thermo.FTM successfully."
runApplication -o decomposePar || exit 1
mpirun -np 4 "$application" -parallel || exit 1
runApplication -o reconstructPar || exit 1
#------------------------------------------------------------------------------
